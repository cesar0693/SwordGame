// SwordGame - Prisma schema
// Covers phases 1-7 of the roadmap so future migrations stay additive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Auth
// --------------------------------------------------------------------------

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  username         String   @unique
  passwordHash     String
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hero Hero?
}

// --------------------------------------------------------------------------
// Hero
// --------------------------------------------------------------------------

enum HeroClass {
  WARRIOR
  MAGE
  RANGER
}

model Hero {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String    @unique
  heroClass         HeroClass
  level             Int       @default(1)
  xp                Int       @default(0)
  unallocatedPoints Int       @default(0)

  // Base stats (equipment bonuses are added at read time)
  hp                Int
  mp                Int
  attack            Int
  defense           Int
  speed             Int
  critChance        Float
  critFailChance    Float
  dodgeChance       Float

  // Appearance stored as JSON for flexibility
  appearance        Json

  // PvP rating (Phase 7)
  pvpRating         Int       @default(1000)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  resources     Resource[]
  companions    Companion[]
  items         Item[]
  missionRuns   MissionRun[]
  heroSpells    HeroSpell[]
  dailyQuests   DailyQuest[]
  dailyClaims   DailyClaim[]
  marketListingsAsSeller MarketListing[] @relation("MarketSeller")
  marketListingsAsBuyer  MarketListing[] @relation("MarketBuyer")
  marketBids             MarketBid[]
  pvpAsAttacker          PvpMatch[] @relation("PvpAttacker")
  pvpAsDefender          PvpMatch[] @relation("PvpDefender")
}

// --------------------------------------------------------------------------
// Resources
// --------------------------------------------------------------------------

enum ResourceType {
  GOLD
  IRON
  COPPER
  SILVER
  GEM
  WOOD
  OAK
  IRONWOOD
  WHEAT
  CORN
  HERB
  MUSHROOM
  FLOWER
  LEATHER
}

model Resource {
  id       String       @id @default(cuid())
  heroId   String
  hero     Hero         @relation(fields: [heroId], references: [id], onDelete: Cascade)
  type     ResourceType
  amount   Int          @default(0)
  lastTickAt DateTime   @default(now())

  @@unique([heroId, type])
}

// --------------------------------------------------------------------------
// Companions (Phase 2) — replaces the old Building model
// --------------------------------------------------------------------------

enum CompanionRole {
  MINER
  WOODCUTTER
  FARMER
  GATHERER
  ALCHEMIST
  BAKER
  BLACKSMITH
}

enum CompanionState {
  LOCKED
  IDLE
  WORKING
}

model Companion {
  id                  String         @id @default(cuid())
  heroId              String
  hero                Hero           @relation(fields: [heroId], references: [id], onDelete: Cascade)
  role                CompanionRole
  level               Int            @default(1)
  cyclesCompleted     Int            @default(0)
  skillPointsUnspent  Int            @default(0)
  activeTrack         String         @default("")
  state               CompanionState @default(LOCKED)
  toolDurability      Int            @default(100)
  unlockedAt          DateTime?
  cycleStartAt        DateTime?
  cycleFinishAt       DateTime?

  spends CompanionSkillSpend[]

  @@unique([heroId, role])
}

enum SkillAxis {
  QUANTITY
  SPEED
}

model CompanionSkillSpend {
  id          String    @id @default(cuid())
  companionId String
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  trackCode   String
  axis        SkillAxis
  createdAt   DateTime  @default(now())

  @@index([companionId, trackCode])
}

// --------------------------------------------------------------------------
// Items / equipment
// --------------------------------------------------------------------------

enum ItemSlot {
  WEAPON
  OFFHAND
  HELMET
  ARMOR
  BOOTS
  RING
  AMULET
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum ItemKind {
  EQUIPMENT
  CONSUMABLE
}

model Item {
  id               String     @id @default(cuid())
  heroId           String
  hero             Hero       @relation(fields: [heroId], references: [id], onDelete: Cascade)
  kind             ItemKind   @default(EQUIPMENT)
  name             String
  slot             ItemSlot?
  rarity           ItemRarity
  upgradeLevel     Int        @default(0)
  bonuses          Json       @default("{}")
  equipped         Boolean    @default(false)
  stack            Int        @default(1)
  effect           Json?
  durationSeconds  Int?
  createdAt        DateTime   @default(now())

  @@index([heroId, slot, equipped])
  @@index([heroId, kind])
}

// --------------------------------------------------------------------------
// Missions & combat (PvE)
// --------------------------------------------------------------------------

model Mission {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  description       String
  minLevel          Int          @default(1)
  durationSeconds   Int
  enemyStats        Json
  rewardXp          Int
  rewardGold        Int
  rewardLoot        Json
  createdAt         DateTime     @default(now())

  runs              MissionRun[]
}

enum MissionStatus {
  PENDING
  COMPLETED
  CLAIMED
}

model MissionRun {
  id         String        @id @default(cuid())
  heroId     String
  hero       Hero          @relation(fields: [heroId], references: [id], onDelete: Cascade)
  missionId  String
  mission    Mission       @relation(fields: [missionId], references: [id])
  seed       String
  startAt    DateTime      @default(now())
  finishAt   DateTime
  status     MissionStatus @default(PENDING)
  report     Json?

  @@index([heroId, status])
}

// --------------------------------------------------------------------------
// Spells
// --------------------------------------------------------------------------

model Spell {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  classLock   HeroClass?
  mpCost      Int
  cooldown    Int
  effect      Json

  learnedBy   HeroSpell[]
}

model HeroSpell {
  id        String   @id @default(cuid())
  heroId    String
  hero      Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  spellId   String
  spell     Spell    @relation(fields: [spellId], references: [id])
  equipped  Boolean  @default(false)
  learnedAt DateTime @default(now())

  @@unique([heroId, spellId])
}

// --------------------------------------------------------------------------
// PvP
// --------------------------------------------------------------------------

enum PvpOutcome {
  ATTACKER_WIN
  DEFENDER_WIN
}

model PvpMatch {
  id             String     @id @default(cuid())
  attackerId     String
  attacker       Hero       @relation("PvpAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defenderId     String
  defender       Hero       @relation("PvpDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  seed           String
  outcome        PvpOutcome
  attackerRatingBefore Int
  defenderRatingBefore Int
  attackerRatingAfter  Int
  defenderRatingAfter  Int
  report         Json
  playedAt       DateTime   @default(now())

  @@index([attackerId, playedAt])
  @@index([defenderId, playedAt])
}

// --------------------------------------------------------------------------
// Daily quests & daily claim
// --------------------------------------------------------------------------

model DailyQuest {
  id         String   @id @default(cuid())
  heroId     String
  hero       Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  code       String
  progress   Int      @default(0)
  target     Int
  rewardJson Json
  completed  Boolean  @default(false)
  day        DateTime

  @@unique([heroId, code, day])
}

model DailyClaim {
  id         String   @id @default(cuid())
  heroId     String
  hero       Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  day        DateTime
  streak     Int
  rewardGold Int
  claimedAt  DateTime @default(now())

  @@unique([heroId, day])
}

// --------------------------------------------------------------------------
// Marketplace
// --------------------------------------------------------------------------

enum MarketListingType {
  INSTANT_BUY
  AUCTION
}

enum MarketListingState {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum MarketAssetType {
  RESOURCE
  ITEM
}

model MarketListing {
  id               String             @id @default(cuid())
  sellerHeroId     String
  sellerHero       Hero               @relation("MarketSeller", fields: [sellerHeroId], references: [id], onDelete: Cascade)
  listingType      MarketListingType
  assetType        MarketAssetType
  resourceType     ResourceType?
  amount           Int?
  itemId           String?            @unique
  priceGold        Int
  buyoutGold       Int?
  highestBid       Int?
  highestBidderId  String?
  state            MarketListingState @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime           @default(now())
  soldAt           DateTime?
  buyerHeroId      String?
  buyerHero        Hero?              @relation("MarketBuyer", fields: [buyerHeroId], references: [id])

  bids MarketBid[]

  @@index([state, assetType, resourceType])
  @@index([sellerHeroId, state])
}

model MarketBid {
  id           String        @id @default(cuid())
  listingId    String
  listing      MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderHeroId String
  bidderHero   Hero          @relation(fields: [bidderHeroId], references: [id], onDelete: Cascade)
  amount       Int
  placedAt     DateTime      @default(now())

  @@index([listingId, placedAt])
}
