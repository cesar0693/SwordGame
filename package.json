{
  "name": "swordgame",
  "version": "0.0.1",
  "private": true,
  "description": "Fantasy hero-management game inspired by Ogame (camp, resources, auto-combat, PvP, forging).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @swordgame/api start:dev",
    "dev:web": "pnpm --filter @swordgame/web start",
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @swordgame/api prisma migrate dev",
    "db:generate": "pnpm --filter @swordgame/api prisma generate",
    "db:studio": "pnpm --filter @swordgame/api prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "~5.6.3"
  }
}
