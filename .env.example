# ============================================================
# Root environment file - copy to .env and adjust
# ============================================================

# --- Database (used by docker-compose and the api) ---
POSTGRES_USER=swordgame
POSTGRES_PASSWORD=swordgame
POSTGRES_DB=swordgame
POSTGRES_PORT=5432

# --- API ---
API_PORT=3000
# When the API runs inside docker-compose, host is "postgres"
# When it runs locally against docker postgres, host is "localhost"
DATABASE_URL=postgresql://swordgame:swordgame@localhost:5432/swordgame?schema=public

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# CORS - comma-separated list
CORS_ORIGINS=http://localhost:4200

# --- Web ---
WEB_PORT=4200
API_BASE_URL=http://localhost:3000
